import java.util.*;
 
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
 
        Set<Long> colors = new HashSet<>();
 
        for (int i = 0; i < 4; i++) {
            colors.add(sc.nextLong());
        }
 
        System.out.println(4 - colors.size());
    }
}